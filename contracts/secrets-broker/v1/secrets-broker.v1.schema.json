{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qbit-vault.dev/contracts/secrets-broker/v1/secrets-broker.v1.schema.json",
  "title": "qbit-vault.secrets-broker/v1",
  "$defs": {
    "contract": { "const": "qbit-vault.secrets-broker/v1" },
    "secretName": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
    "session": { "type": "string", "pattern": "^[a-z0-9-]+:[A-Za-z0-9._-]{4,128}$" },
    "scope": { "enum": ["once", "session", "project"] },
    "rfc3339": { "type": "string", "format": "date-time" },
    "envelope": {
      "type": "object",
      "required": ["contract", "op", "v", "session", "cwd"],
      "properties": {
        "contract": { "$ref": "#/$defs/contract" },
        "op": { "enum": ["request", "list", "exec", "manage", "grant", "revoke", "capabilities"] },
        "v": { "const": 1 },
        "session": { "$ref": "#/$defs/session" },
        "cwd": { "type": "string", "minLength": 1 },
        "host": {
          "type": "object",
          "properties": { "name": {"type": "string"}, "version": {"type": "string"} },
          "additionalProperties": false
        }
      }
    },
    "grant": {
      "type": "object",
      "required": ["scope", "expires_at"],
      "properties": {
        "scope": { "$ref": "#/$defs/scope" },
        "expires_at": { "oneOf": [{"$ref": "#/$defs/rfc3339"}, {"type": "null"}] }
      },
      "additionalProperties": false
    },
    "secretMeta": {
      "type": "object",
      "required": [
        "name",
        "layer",
        "overrides_global",
        "kind",
        "sensitive",
        "binaries",
        "hosts",
        "created_at",
        "updated_at",
        "grant"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/secretName" },
        "layer": { "$ref": "#/$defs/layer" },
        "overrides_global": { "type": "boolean" },
        "kind": { "$ref": "#/$defs/fieldKind" },
        "description": { "type": "string", "maxLength": 200 },
        "sensitive": { "type": "boolean" },
        "binaries": { "type": "array", "items": {"type": "string"} },
        "hosts": { "type": "array", "items": {"type": "string"} },
        "created_at": { "$ref": "#/$defs/rfc3339" },
        "updated_at": { "$ref": "#/$defs/rfc3339" },
        "grant": { "oneOf": [{"$ref": "#/$defs/grant"}, {"type": "null"}] }
      },
      "additionalProperties": false
    },
    "refusal": {
      "type": "object",
      "required": ["ok", "refusal"],
      "properties": {
        "ok": { "const": false },
        "refusal": {
          "type": "object",
          "required": ["type", "name", "message", "retryable"],
          "properties": {
            "type": {
              "enum": [
                "grant_required",
                "unknown_secret",
                "user_declined",
                "rate_limited",
                "reason_too_vague",
                "invalid_name",
                "scope_not_allowed",
                "scope_binary",
                "no_project",
                "dump_command",
                "not_model_callable",
                "vault_locked",
                "vault_corrupt",
                "timeout",
                "contract_mismatch",
                "internal"
              ]
            },
            "name": { "oneOf": [{"$ref": "#/$defs/secretName"}, {"type": "null"}] },
            "message": { "type": "string", "maxLength": 500 },
            "retryable": { "type": "boolean" },
            "partial": { "type": "object", "properties": {"stdout": {"type": "string"}, "stderr": {"type": "string"}} }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "fieldKind": { "enum": ["secret", "text"] },
    "field": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/secretName" },
        "kind": { "$ref": "#/$defs/fieldKind" },
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "description": { "type": "string", "maxLength": 200 }
      },
      "additionalProperties": false
    },
    "secretRef": { "type": "string", "pattern": "^secret://[A-Z][A-Z0-9_]{0,63}$" },
    "requestReq": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": ["reason"],
          "oneOf": [
            { "required": ["name"], "not": { "required": ["fields"] } },
            { "required": ["fields"], "not": { "required": ["name"] } }
          ],
          "properties": {
            "op": { "const": "request" },
            "name": { "$ref": "#/$defs/secretName" },
            "fields": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/field" } },
            "reason": { "$ref": "#/$defs/reason" },
            "suggested_scope": { "$ref": "#/$defs/scope" },
            "suggested_layer": { "$ref": "#/$defs/layer" }
          }
        }
      ]
    },
    "requestRes": {
      "type": "object",
      "required": ["ok", "refs", "grant"],
      "properties": {
        "ok": { "const": true },
        "refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["name", "ref", "layer"],
            "properties": {
              "name": { "$ref": "#/$defs/secretName" },
              "ref": { "$ref": "#/$defs/secretRef" },
              "layer": { "$ref": "#/$defs/layer" }
            },
            "additionalProperties": false
          }
        },
        "ref": { "$ref": "#/$defs/secretRef" },
        "layer": { "$ref": "#/$defs/layer" },
        "grant": { "$ref": "#/$defs/grant" }
      },
      "additionalProperties": false
    },
    "listReq": { "allOf": [{"$ref": "#/$defs/envelope"}, {"properties": {"op": {"const": "list"}}}] },
    "listRes": {
      "type": "object",
      "required": ["ok", "project", "secrets", "policy"],
      "properties": {
        "ok": { "const": true },
        "project": { "$ref": "#/$defs/project" },
        "secrets": { "type": "array", "items": {"$ref": "#/$defs/secretMeta"} },
        "unlinked_match": {
          "oneOf": [
            { "type": "object", "required": ["label"], "properties": { "label": {"type": "string"} }, "additionalProperties": false },
            { "type": "null" }
          ]
        },
        "policy": { "$ref": "#/$defs/policy" }
      },
      "additionalProperties": false
    },
    "execReq": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": ["command", "secrets"],
          "properties": {
            "op": { "const": "exec" },
            "command": { "type": "string", "minLength": 1, "maxLength": 16384 },
            "secrets": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "object",
                "required": ["name"],
                "properties": { "name": {"$ref": "#/$defs/secretName"}, "from": {"$ref": "#/$defs/secretName"} },
                "additionalProperties": false
              }
            },
            "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
            "shell": { "enum": ["auto", "sh", "bash", "cmd", "pwsh"] }
          }
        }
      ]
    },
    "execRes": {
      "type": "object",
      "required": ["ok", "exit_code", "stdout", "stderr", "duration_ms", "redactions", "truncated"],
      "properties": {
        "ok": { "const": true },
        "exit_code": { "type": "integer" },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "redactions": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "manageReq": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": ["action", "name", "layer", "reason"],
          "properties": {
            "op": { "const": "manage" },
            "action": { "enum": ["remove", "edit", "move", "replace"] },
            "name": { "$ref": "#/$defs/secretName" },
            "layer": { "$ref": "#/$defs/layer" },
            "reason": { "$ref": "#/$defs/reason" },
            "to": { "$ref": "#/$defs/layer" },
            "changes": {
              "type": "object",
              "minProperties": 1,
              "properties": {
                "description": { "type": "string", "maxLength": 200 },
                "binaries": { "type": "array", "items": {"type": "string"} },
                "hosts": { "type": "array", "items": {"type": "string"} },
                "sensitive": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          },
          "allOf": [
            {
              "if": { "properties": {"action": {"const": "move"}} },
              "then": { "required": ["to"] },
              "else": { "not": {"required": ["to"]} }
            },
            {
              "if": { "properties": {"action": {"const": "edit"}} },
              "then": { "required": ["changes"] },
              "else": { "not": {"required": ["changes"]} }
            }
          ]
        }
      ]
    },
    "manageRes": {
      "type": "object",
      "required": ["ok", "applied", "action", "name", "layer"],
      "properties": {
        "ok": { "const": true },
        "applied": { "const": true },
        "action": { "enum": ["remove", "edit", "move", "replace"] },
        "name": { "$ref": "#/$defs/secretName" },
        "layer": { "oneOf": [{"$ref": "#/$defs/layer"}, {"type": "null"}] }
      },
      "additionalProperties": false
    },
    "grantReq": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": ["name", "layer", "scope"],
          "properties": {
            "op": { "const": "grant" },
            "name": { "$ref": "#/$defs/secretName" },
            "layer": { "$ref": "#/$defs/layer" },
            "scope": { "$ref": "#/$defs/scope" },
            "ttl_ms": { "type": "integer", "minimum": 60000, "maximum": 86400000 },
            "prompt_token": { "type": "string", "minLength": 16 }
          }
        }
      ]
    },
    "grantRes": {
      "type": "object",
      "required": ["ok", "grant"],
      "properties": { "ok": {"const": true}, "grant": {"$ref": "#/$defs/grant"} },
      "additionalProperties": false
    },
    "revokeReq": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "properties": {
            "op": { "const": "revoke" },
            "name": { "$ref": "#/$defs/secretName" },
            "all": { "type": "boolean" },
            "session_only": { "type": "boolean" }
          }
        }
      ]
    },
    "revokeRes": {
      "type": "object",
      "required": ["ok", "revoked"],
      "properties": { "ok": {"const": true}, "revoked": {"type": "integer", "minimum": 0} },
      "additionalProperties": false
    },
    "capabilitiesReq": { "allOf": [{"$ref": "#/$defs/envelope"}, {"properties": {"op": {"const": "capabilities"}}}] },
    "capabilitiesRes": {
      "type": "object",
      "required": ["ok", "contract", "capabilities", "ops", "layers", "prompt_backends", "field_kinds", "max_fields", "keychain", "streaming", "sync"],
      "properties": {
        "ok": { "const": true },
        "contract": { "$ref": "#/$defs/contract" },
        "capabilities": { "type": "string", "pattern": "^1\\.[0-9]+$" },
        "ops": { "type": "array", "items": {"type": "string"} },
        "layers": { "type": "array", "items": {"$ref": "#/$defs/layer"} },
        "prompt_backends": {
          "type": "array",
          "items": { "enum": ["pi-ui", "osascript", "powershell", "zenity", "kdialog", "tty"] }
        },
        "field_kinds": { "type": "array", "items": {"$ref": "#/$defs/fieldKind"} },
        "max_fields": { "type": "integer", "minimum": 1 },
        "keychain": { "enum": ["macos-keychain", "windows-credential-manager", "secret-service", "passphrase-file"] },
        "streaming": { "type": "boolean" },
        "sync": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "layer": { "enum": ["global", "project"] },
    "reason": { "type": "string", "minLength": 8, "maxLength": 200 },
    "policy": {
      "type": "object",
      "required": ["can", "cannot", "layers", "scopes", "cooldowns"],
      "properties": {
        "can": { "type": "array", "items": {"type": "string"} },
        "cannot": { "type": "array", "items": {"type": "string"} },
        "layers": { "type": "array", "items": {"$ref": "#/$defs/layer"} },
        "scopes": { "type": "array", "items": {"$ref": "#/$defs/scope"} },
        "cooldowns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "until"],
            "properties": { "name": {"$ref": "#/$defs/secretName"}, "until": {"$ref": "#/$defs/rfc3339"} },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "project": {
      "oneOf": [
        {
          "type": "object",
          "required": ["root", "label"],
          "properties": { "root": {"type": "string", "minLength": 1}, "label": {"type": "string"} },
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/requestReq" },
    { "$ref": "#/$defs/requestRes" },
    { "$ref": "#/$defs/listReq" },
    { "$ref": "#/$defs/listRes" },
    { "$ref": "#/$defs/execReq" },
    { "$ref": "#/$defs/execRes" },
    { "$ref": "#/$defs/manageReq" },
    { "$ref": "#/$defs/manageRes" },
    { "$ref": "#/$defs/grantReq" },
    { "$ref": "#/$defs/grantRes" },
    { "$ref": "#/$defs/revokeReq" },
    { "$ref": "#/$defs/revokeRes" },
    { "$ref": "#/$defs/capabilitiesReq" },
    { "$ref": "#/$defs/capabilitiesRes" },
    { "$ref": "#/$defs/refusal" }
  ]
}
