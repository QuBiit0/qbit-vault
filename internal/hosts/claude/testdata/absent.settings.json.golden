{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/qbit/bin/qbit-vault",
            "args": [
              "hook",
              "pre-bash"
            ],
            "timeout": 10,
            "statusMessage": "qbit-vault hook pre-bash"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/qbit/bin/qbit-vault",
            "args": [
              "hook",
              "pre-write"
            ],
            "timeout": 30,
            "statusMessage": "qbit-vault hook pre-write"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/qbit/bin/qbit-vault",
            "args": [
              "hook",
              "post-bash"
            ],
            "timeout": 30,
            "statusMessage": "qbit-vault hook post-bash"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/qbit/bin/qbit-vault",
            "args": [
              "hook",
              "post-read"
            ],
            "timeout": 30,
            "statusMessage": "qbit-vault hook post-read"
          }
        ]
      },
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/qbit/bin/qbit-vault",
            "args": [
              "hook",
              "post-read"
            ],
            "timeout": 30,
            "statusMessage": "qbit-vault search output guard"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/qbit/bin/qbit-vault",
            "args": [
              "hook",
              "user-prompt"
            ],
            "timeout": 30,
            "statusMessage": "qbit-vault hook user-prompt"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read({HOME}/.qbit-vault/**)",
      "Edit({HOME}/.qbit-vault/**)"
    ]
  }
}
