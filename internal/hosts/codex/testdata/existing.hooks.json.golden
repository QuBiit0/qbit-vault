{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/opt/orca/hooks/codex-hook.cjs\" prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/opt/orca/hooks/codex-hook.cjs\" pre",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/qbit/bin/qbit-vault hook pre-write --host codex",
            "timeout": 30,
            "statusMessage": "qbit-vault hook pre-write"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/opt/orca/hooks/codex-hook.cjs\" post",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/qbit/bin/qbit-vault hook post-bash --host codex",
            "timeout": 30,
            "statusMessage": "qbit-vault hook post-bash"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/opt/orca/hooks/codex-hook.cjs\" stop"
          }
        ]
      }
    ]
  }
}
