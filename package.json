{
  "name": "qbit-vault-pi",
  "version": "0.2.1",
  "description": "Pi / Gentle Shell extension for QBit Vault: /vault commands and a vault status in the footer. Never sees a secret value.",
  "keywords": [
    "pi-package",
    "qbit-vault",
    "secrets"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qbitdevz/qbit-vault.git"
  },
  "engines": {
    "node": ">=20"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "files": [
    "dist",
    "secret-patterns.yaml",
    "README.md",
    "LICENSE"
  ]
}
