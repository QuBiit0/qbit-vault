{
	"model": "opus",
	"hooks": {
		"PreToolUse": [
			{ "matcher": "Bash", "hooks": [{ "type": "command", "command": "gentle-ai hook guard" }] },
			{
				"matcher": "Bash|PowerShell",
				"hooks": [
					{
						"type": "command",
						"command": "/opt/qbit/bin/qbit-vault",
						"args": [
							"hook",
							"pre-bash"
						],
						"timeout": 10,
						"statusMessage": "qbit-vault hook pre-bash"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [{ "type": "command", "command": "prettier --write" }]
			},
			{
				"matcher": "Bash|PowerShell",
				"hooks": [
					{
						"type": "command",
						"command": "/opt/qbit/bin/qbit-vault",
						"args": [
							"hook",
							"post-bash"
						],
						"timeout": 30,
						"statusMessage": "qbit-vault hook post-bash"
					}
				]
			},
			{
				"matcher": "Read",
				"hooks": [
					{
						"type": "command",
						"command": "/opt/qbit/bin/qbit-vault",
						"args": [
							"hook",
							"post-read"
						],
						"timeout": 30,
						"statusMessage": "qbit-vault hook post-read"
					}
				]
			}
		],
		"Stop": [
			{ "hooks": [{ "type": "command", "command": "notify-send done" }] }
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "/opt/qbit/bin/qbit-vault",
						"args": [
							"hook",
							"user-prompt"
						],
						"timeout": 30,
						"statusMessage": "qbit-vault hook user-prompt"
					}
				]
			}
		]
	},
	"permissions": {
		"allow": ["Bash(git status)"],
		"deny": [
			"Read(~/.ssh/**)",
			"Read(**/.env)",
			"Read({HOME}/.qbit-vault/**)",
			"Edit({HOME}/.qbit-vault/**)"
		]
	}
}
